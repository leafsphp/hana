---
// 花びら — a field of sakura petals drifting down the page.
// Pure CSS: each petal is a rounded-one-corner span with its own
// duration/delay/drift so the fall never visibly repeats.
const petals = [
  { left: '6%', size: 14, duration: 34, delay: -4, blur: 0, opacity: 0.5, tint: 'pink' },
  { left: '14%', size: 22, duration: 26, delay: -18, blur: 2, opacity: 0.35, tint: 'blue' },
  { left: '24%', size: 10, duration: 40, delay: -9, blur: 0, opacity: 0.45, tint: 'blue' },
  { left: '33%', size: 30, duration: 22, delay: -2, blur: 4, opacity: 0.22, tint: 'pink' },
  { left: '45%', size: 12, duration: 36, delay: -25, blur: 0, opacity: 0.5, tint: 'pink' },
  { left: '55%', size: 18, duration: 28, delay: -12, blur: 1, opacity: 0.4, tint: 'blue' },
  { left: '64%', size: 26, duration: 24, delay: -20, blur: 3, opacity: 0.25, tint: 'pink' },
  { left: '72%', size: 11, duration: 38, delay: -6, blur: 0, opacity: 0.5, tint: 'blue' },
  { left: '81%', size: 16, duration: 30, delay: -15, blur: 1, opacity: 0.4, tint: 'pink' },
  { left: '90%', size: 24, duration: 25, delay: -10, blur: 3, opacity: 0.25, tint: 'blue' },
  { left: '96%', size: 13, duration: 35, delay: -22, blur: 0, opacity: 0.45, tint: 'pink' },
];
---

<div class="petal-field" aria-hidden="true">
  <div class="glow"></div>
  {
    petals.map((p) => (
      <span
        class={`petal ${p.tint}`}
        style={`left: ${p.left}; width: ${p.size}px; height: ${p.size}px; animation-duration: ${p.duration}s; animation-delay: ${p.delay}s; filter: blur(${p.blur}px); --petal-opacity: ${p.opacity};`}
      />
    ))
  }
</div>

<style>
  .petal-field {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160vh;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    top: -10vh;
    left: 50%;
    width: 70vw;
    height: 55vh;
    transform: translateX(-50%);
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(139, 156, 224, 0.14) 0%,
      rgba(195, 145, 217, 0.06) 55%,
      transparent 100%
    );
    filter: blur(60px);
  }

  .petal {
    position: absolute;
    top: -40px;
    /* one sharp corner, three soft — the sakura petal silhouette */
    border-radius: 100% 4% 100% 100%;
    opacity: var(--petal-opacity);
    animation-name: petal-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .petal.pink {
    background: linear-gradient(140deg, #c391d9 0%, #8f6fae 100%);
  }

  .petal.blue {
    background: linear-gradient(140deg, #8b9ce0 0%, #5e79c7 100%);
  }

  @keyframes petal-fall {
    0% {
      transform: translate3d(0, -5vh, 0) rotate(0deg);
    }
    25% {
      transform: translate3d(-4vw, 38vh, 0) rotate(140deg);
    }
    50% {
      transform: translate3d(3vw, 80vh, 0) rotate(260deg);
    }
    75% {
      transform: translate3d(-3vw, 122vh, 0) rotate(380deg);
    }
    100% {
      transform: translate3d(2vw, 165vh, 0) rotate(520deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal {
      animation: none;
      display: none;
    }
  }

  @media (max-width: 730px) {
    .petal-field {
      height: 100vh;
    }
    .petal:nth-of-type(2n) {
      display: none;
    }
  }
</style>
